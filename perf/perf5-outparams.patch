diff --git a/src/physics/force.js b/src/physics/force.js
index 3fb77f7..0cb0a4f 100644
--- a/src/physics/force.js
+++ b/src/physics/force.js
@@ -41,3 +41,24 @@ export function force3(ax, ay, az, limit = DEFAULT_FORCE_LIMIT) {
     az: clamp(nanGuard(az), -limit, limit),
   };
 }
+
+/**
+ * PERF-5: write a force triple into a caller-owned scratch object instead of
+ * allocating one. With no `out` this is exactly the old object literal, so
+ * callers that keep the result (tests, diagnostics) behave as before. The
+ * solver passes one scratch and consumes each result before the next call.
+ * Arguments are evaluated in the same order as the old { ax, ay, az } literal.
+ */
+export function outForce(out, ax, ay, az) {
+  if (out) { out.ax = ax; out.ay = ay; out.az = az; return out; }
+  return { ax, ay, az };
+}
+
+/** force3() written into `out` when given (PERF-5); identical values. */
+export function force3Into(out, ax, ay, az, limit = DEFAULT_FORCE_LIMIT) {
+  if (!out) return force3(ax, ay, az, limit);
+  out.ax = clamp(nanGuard(ax), -limit, limit);
+  out.ay = clamp(nanGuard(ay), -limit, limit);
+  out.az = clamp(nanGuard(az), -limit, limit);
+  return out;
+}
