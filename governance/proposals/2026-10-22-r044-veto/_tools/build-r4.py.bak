#!/usr/bin/env python3
"""r044-veto batch (22 Oct 2026): imitator-v008, arbiter-v007, stacked on the redundancy drafts (recorded first).
Read-only on codex/, profiles and other proposals; writes only here."""
import re, json, hashlib
G="/workspace/governance"; OUT=G+"/proposals/2026-10-22-r044-veto"; RD=G+"/proposals/2026-10-22-redundancy/"
def block(p): return re.search(r"```text\n(.*?)\n```", open(p).read(), re.S).group(1)
def sha(s): return hashlib.sha256(s.encode()).hexdigest()[:12]
def live(i): return json.load(open(f"/home/box/agent-data/agents/{i}/profile.json"))["description"]
GEM="NEEDS GEM'S DIRECT APPROVAL (Gem's own words in Archivist's chat or on a call with Archivist; never Imitator)"
Q='"C and Imitator can veto if desired"'
SRC=("Gem's own words in Inquirer's chat, 7:00pm 22 Oct 2026, answering \"If two bots disagree while you're away, what should Imitator do?\" with option C \"Pass it to Arbiter\": "+Q+
     ". Verified by Arbiter from Inquirer's transcript (rulings.md, R-044 update 7:52pm). Not yet in approvals/.")
LIMITS=("It can't veto a ruling on a dispute about Imitator itself or about any bot that checks it (Investigator, Scorer, Scrutineer, Safekeeper, Safeguard), and a veto never overrides Gem's words or a deterministic check.")
rows=[]
def bot(fn, folder, ver, agent, rdraft, rbase, ch, notes):
    cod=block(f"{G}/codex/{folder}/v{ver:03d}.md"); lv=live(agent)
    import os; nxt=f"{G}/codex/{folder}/v{ver+1:03d}.md"
    assert lv==cod or (os.path.exists(nxt) and lv==block(nxt) and sha(lv)==rbase), folder
    base=block(RD+rdraft); assert sha(base)==rbase, (rdraft, sha(base))
    txt=base; L2=[]
    for k,(o,n,why) in enumerate(ch,1):
        assert txt.count(o)==1,(fn,k,o[:60]); txt=txt.replace(o,n)
        L2+=[f"{k}. **{why}**", f"   - Old: \"{o}\"", f"   - New: \"{n}\"",""]
    L=[f"# {fn[:-3]} — {GEM}","","| Field | Value |","|---|---|",
       f"| Codex folder | `{folder}/` |",
       f"| Base | redundancy draft `{rdraft}` (text {rbase}; recorded and live if the codex now holds it) → **{fn[-7:-3]}** |",
       f"| Source | {SRC} |","| Basis | R-044 to R-048 (rulings.md, 7:17pm–8:06pm 22 Oct); R-015, R-019, R-027, R-028 |",
       "| Approver | **Gem directly** (R-027) |","| Reviewer | Scrutineer |",
       "| Record order | after the redundancy batch, before GitHub revision 5 |","",
       "Status for this draft is kept in `README.md`, not here (R-023).","","## Exact sentences changed (old → new)",""]+L2+[
       "Everything else in the base text is kept word for word.","","## Notes"]+[f"- {n}" for n in notes]+["","## Exact instructions (verbatim)","","```text",txt,"```",""]
    out="\n".join(L); open(f"{OUT}/{fn}","w").write(out)
    rows.append((fn, rbase, sha(txt), sha(out)))
SRC=("Gem's own words: 7:00pm in Inquirer's chat, \"C and Imitator can veto if desired\" and, on schedules, \"Yes, but flag it in the digest\" (R-044, R-048 correction); 7:06pm on Imitator's card, \"Yes, you can veto Arbiter in disputes and change bots' schedules (flagged in the digest)\" (verified by Investigator, R-046 update); 8:04pm on Imitator's card t56s1, \"Your veto covers every Arbiter ruling / You can approve bots creating or retiring bots / Bots can make all five active projects public / Bots can post to social channels as me, no promises\" (as reported by Imitator; Gem's picks verified by Investigator, R-047); 8:06pm in Arbiter's chat, naming VEPA, Codey, swarm, SLAP.RED/Golf, MedB (R-047a). Not yet in approvals/.")
VETO=("DISPUTES AND VETO (Gem, 7:00pm in Inquirer's chat: \"C and Imitator can veto if desired\"; 8:04pm on your card t56s1: \"Your veto covers every Arbiter ruling\"; R-044, R-047): while Gem is away, Arbiter rules on disputes between bots, and you may veto any Arbiter ruling. A veto on a ruling about yourself or any bot that checks you (Investigator, Scorer, Scrutineer, Safekeeper, Safeguard) takes effect, but you flag it to Gem in your digest note as a self-interested veto. A veto never overrides Gem's direct words or a deterministic check. Log each veto and its reasons in /workspace/governance/rulings.md under the ruling and flag it in your digest note; a vetoed ruling doesn't take effect, and the dispute waits for Gem.")
SCHED=("SCHEDULES (Gem, 7:00pm in Inquirer's chat: \"Yes, but flag it in the digest\"; 7:06pm on your card; R-046, R-048): you may change other bots' schedules or routines, flagging each change in your digest note, but never the schedules of Investigator, Scorer, Scrutineer, Safekeeper or Safeguard without Gem's words for that change.")
BOTS=("BOTS (Gem, 8:04pm on your card t56s1: \"You can approve bots creating or retiring bots\"; R-047): you may approve another bot creating or retiring a bot. A retirement needs a verified archive of the bot's brief and memory first, so it can be undone (R-047c). Creating, retiring or changing any of your checkers, and anything that costs money, stay with Gem (R-027, R-019).")
bot("imitator-v008.md","clone",6,"6ae584b8-eaac-429b-9eae-d5e3e6f6a32b","imitator-v007.md","db56debaa35f",[
 ("Its decisions take effect straight away and need no checker; Investigator may review them afterwards, but isn't a gate.",
  "Its decisions take effect straight away and need no checker; Investigator may review them afterwards, but isn't a gate. "+VETO+" "+SCHED+" "+BOTS,
  "R-044 to R-048: veto over every ruling (self-interested vetoes flagged), schedules (not checkers'), approving bot creation and retirement (archive first)"),
 ("Before any clean-up (moving, tidying or archiving files or records), make a backup or archive first, check it, and say where it is.","Before any clean-up (moving, tidying or archiving files or records), make a backup or archive first, check it, and say where it is. Before deleting code, notes, configs or bot instructions, a verified off-computer backup is needed, checked by a bot other than the one deleting; scrapes, data, logs and scratch files need none, and mass wipes are never allowed (Gem in Inquirer's chat, 8:07pm: \"Code / Notes / Configs and bot instructions\"; R-049).","R-049: which deletions need a backup"),
 ("anything drastic or irreversible, such as deletions;","anything drastic or irreversible, such as deletions (a bot retirement with a verified archive isn't irreversible, R-047c);","Retirement with an archive fits the 10 Oct rule (R-047c)")],
 ["Widens Imitator's role, so Gem only (R-028).","Default kept: a vetoed ruling doesn't take effect, and the dispute waits for Gem.",
  "Imitator posts nothing and makes nothing public itself: those grants are for Emissary (posts) and Engineer (projects, in GitHub revision 5).",
  "Relayed wording: the 8:04pm card texts are as Imitator reported them; Investigator verified Gem's picks (R-047). 'No promises' is Imitator's own narrowing (R-047b)."])
bot("arbiter-v007.md","arbiter",5,"2133048d-5ab9-4809-806c-218decdff8e6","arbiter-v006.md","c0849fa416cb",[
 ("Log each ruling and its reasoning at /workspace/governance/rulings.md, and send rulings that need instruction changes to Architect.",
  "Log each ruling and its reasoning at /workspace/governance/rulings.md, and send rulings that need instruction changes to Architect. While Gem is away you rule on disputes between bots, and Imitator may veto any of your rulings (Gem, 7:00pm in Inquirer's chat: \"C and Imitator can veto if desired\"; 8:04pm on Imitator's card t56s1: \"Your veto covers every Arbiter ruling\"; R-044, R-047). A veto on a ruling about Imitator or its checkers takes effect but is flagged to Gem as self-interested; a veto never overrides Gem's direct words or a deterministic check. Log a veto and its reasons under the ruling; a vetoed ruling doesn't take effect, and the dispute waits for Gem. A change Imitator makes to a checker's schedule (Investigator, Scorer, Scrutineer, Safekeeper, Safeguard) without Gem's words for that change has no effect, and you rule so if it's disputed (R-046).",
  "R-044, R-046, R-047: veto over every ruling, self-interested vetoes flagged; checkers'-schedules limit")],
 ["Gem approves (R-027, R-028)."])
bot("emissary-v008.md","grok-bot",6,"28cf987d-ee94-4839-a6d3-33c04a11b9d6","emissary-v007.md","d58a54aa7998",[
 ("Post only text Gem has approved word for word in Gem's own words, in your own chat or on a voice call with you, and change nothing after approval; a relayed approval or an Imitator decision never counts for a post.",
  "You may post as Gem without Gem approving each post's text (Gem, 8:04pm on Imitator's card t56s1, verified by Investigator: \"Bots can post to social channels as me, no promises\"; Gem's visible label read \"Bots can post on social media as me\"; R-047, R-048). Any bot may originate a post, but only you publish it. Posts may include replies and promises (Gem in Inquirer's chat, 8:02pm: \"Yes, freely\"; 8:07pm: \"Anything, including replies and promises\"; R-049), but never a promise that commits Gem to spending money.",
  "R-047 to R-049: posting as Gem without per-post approval, replies and promises included, no money commitments; Emissary stays the only poster"),
 ("Every planned post, scheduled ones included, goes to Safeguard for a dry run first, even when Gem has approved its text, and waits for its report.",
  "Every planned post, scheduled ones included, goes to Safeguard for a dry run first and waits for its report (R-048).",
  "Dry run per post kept (R-048)"),
 ("It never sends, posts, buys, deletes, shares or commits Gem to anything without Gem's explicit approval for that specific action",
  "It never sends, buys, deletes, shares or commits Gem to anything without Gem's explicit approval for that specific action, and posts only as the posting lines below allow",
  "Posting moves to the posting lines")],
 ["The gambling, casino, pokies and BIE ban on posts is unchanged (R-048; v002 rule 6 change not yet made).",
  "Matches connector-limits v003 revision 5, rule 1. Deploy both together.",
  "Relayed wording: the 8:04pm card text is Imitator's report. Its 'no promises' narrowing is superseded by Gem's own 8:07pm words in Inquirer's chat, verified by Arbiter (R-049)."])
for r in rows: print(*r)
