#!/usr/bin/env python3
"""connector-limits v003 draft (gvmw exception), 22 Oct 2026. Relayed by Mediator (R-008).
Read-only on codex/; writes only in this folder. Never reads token or credential files."""
import re, hashlib, glob, difflib
G="/workspace/governance"; OUT=G+"/proposals/2026-10-22-gvmw"
def block(p): return re.search(r"```text\n(.*?)\n```",open(p).read(),re.S).group(1)
def sha(s): return hashlib.sha256(s.encode()).hexdigest()[:12]
vers=sorted(glob.glob(G+"/codex/_shared/connector-limits/v*.md"))
assert vers[-1].endswith("v002.md"), vers
base=block(vers[-1]); assert sha(base)=="d4fbfa8f391f", sha(base)
assert base==block(G+"/proposals/2026-10-16-connectors2/connector-limits-v002.md")
L=base.split("\n")
def R(t,a,b):
    assert t.count(a)==1,a[:60]; return t.replace(a,b)
C="4f43fc9ae82eb1beaf63bf4ea33fcd699aae5adf"
HEAD=("The gvmw exception (Gem's direct words, 22 Oct 2026; R-040, R-042). Gem made the repo gemquota/gvmw public on purpose and accepts the risks of keeping it public, including the Interactive Gambling Act exposure of the BIE and gambling data, the Privacy Act exposure of the third-party contact details, and the exposure of Gem's own identity notes; that's Gem's own call, and bots only set out risks and options. "
 "The exception covers only that repo, and only the content in it as of commit 4f43fc9 (4f43fc9ae82eb1beaf63bf4ea33fcd699aae5adf, 22 Oct 2026)")
IDN="Gem's own identity notes id-investigator/factcheck-2026-10-10.md and id-notes/projects-map-2026-10-10.md"
R031=(" For this repo only, Gem's approval also counts as the R-031 permission (as in R-042) for the bonus_terms and BIE files already in it at 4f43fc9: everything under bie/, bie_deliverables/ and bie_tools/, including the bonus_terms_AU files. bonus_scores_AU.xlsx isn't in the repo and isn't covered; R-031 still applies to it and to every other destination.")
REMOVE=(" Gem's approval of this rule counts as Gem's direct words to remove {X} from the repo's current tree only; a history rewrite needs separate words from Gem, and until then they remain in the git history. Engineer removes them, after making a backup first (a private copy on the box), a secret scan and a Safeguard dry run. Before anything is removed, Safeguard's dry run lists the exact paths to be removed, saved on the box, and any file that mixes BIE data with contact details goes to Gem before it's touched. Until they're removed, they stay as they are and nothing is added to them.")
SCOPE_A=(", including its governance/ folder, its BIE and gambling data, its third-party contact details, and "+IDN+"."+R031)
SCOPE_B=(", including its governance/ folder, its BIE and gambling data, and "+IDN+", but not its third-party contact details."+R031+REMOVE.replace("{X}","the third-party contact details"))
SCOPE_C=(", including its BIE and gambling data and "+IDN+", but not its third-party contact details or its governance/ folder."+R031+REMOVE.replace("{X}","the third-party contact details and the governance/ folder"))
TAIL=(" It doesn't roll forward with the sync: any new content, of any kind, including any new identity notes or other personal data about Gem, needs fresh direct words from Gem and a Safeguard dry run (R-042). It covers no other repo, fork, gist, Pages site, release or package, and no other channel in rule 6. "
 "No secret, token, key, password, cookie or credential ever goes into the repo: Safekeeper secret-scans every push before it goes, and anything found isn't pushed. Engineer's sync stays add-only. The daily sync is on (Gem's 7:55pm words; R-045 update). Its per-push and per-run checks follow the gvmw rule: R-051 records Gem's later answer, \"Engineer fully free, no per-push checks\", so none are required and Safekeeper may scan afterwards without blocking; Gem's answer on the user's card is pending, and if it restores checks, each push and run needs a secret scan and a Safeguard dry run first. A dry run is never a go-ahead. After every push the pushing bot reads back the repo's visibility and owner, and Safeguard or Scrutineer confirms them independently (R-040). "
 "R-043 (final) settled the 4f43fc9 push: Gem's words covered it, leaving two process gaps for Engineer. This exception doesn't settle who made the repo public. "
 "Safeguard reviews this exception by 22 Nov 2026 and puts it back to Gem. If Gem hasn't decided by then, the exception stays in force and nothing is removed automatically, and Safeguard raises it with Gem in Explorer's daily digest until Gem decides.")
def build(exc, contacts):
    T=list(L)
    T[0]=R(T[0],"CONNECTOR LIMITS v002","CONNECTOR LIMITS v003")
    T[4]=R(T[4],"Post only text Gem has approved word for word in direct words, with only the images and links Gem approved, and change nothing after approval.","Emissary may post as Gem, replies and promises included, without Gem approving each post's text (Gem in Inquirer's chat, 8:02pm 22 Oct 2026: \"Yes, freely\", and 8:07pm: \"Anything, including replies and promises\"; R-047, R-049); any bot may originate a post, but only Emissary publishes it, no post commits Gem to spending money, and each goes to Safeguard for a dry run first.")
    # rule 6
    T[9]=R(T[9],"published vaults, emails and messages.","published vaults, emails and messages. The only exception is gemquota/gvmw under rule 14's gvmw exception; it doesn't cover posting, publishing or scheduling through postiz, Zapier, n8n, Notion, Todoist, Supabase, Obsidian, Gmail, X or any other channel.")
    # rule 14
    T[17]=R(T[17],"An auto-sync or scheduled push is an ongoing push and needs approval as such (rule 12).","An auto-sync or scheduled push is an ongoing push and needs approval as such (rule 12). "+exc)
    T[12]=R(T[12],"needs Gem's direct words naming the item and who, and a Safeguard dry run, as in rules 3, 7 and 8.","needs Gem's direct words naming the item and who, and a Safeguard dry run, as in rules 3, 7 and 8. The one exception (Explorer's sharing carve-out in LIMITS): Explorer may share a Notion page or Todoist task that is its own with people Gem already shares with in that workspace, without per-item words from Gem but with a Safeguard dry run for each share. Explorer keeps a log on the box, like rule 16's, of the id and time of each page or task it creates and of each share (what, with whom, when); only items logged as Explorer's count as its own. Publishing to the web, inviting or sharing with anyone new, and assigning a task to anyone other than Gem keep the gate above. That sharing never includes secrets, sensitive personal details, or BIE or gambling content (rule 6 still applies). Other bots' sharing stays as above.")
    T[14]=R(T[14],"No bot adds, changes or deletes memories until Mem0 works (it doesn't yet: no key) and Gem's direct words name the writer and what it's for.","Emissary and Explorer may add Mem0 memories once Mem0 works (it doesn't yet: no key) (Gem's direct words, 22 Oct 2026); this doesn't cover Notion's memories or any other memory store. No other bot adds memories, and no bot changes or deletes them without Gem's direct words.")
    T[24]=R(T[24],"A dry run is never a go-ahead, this rule has no dry-run waivers, and it never replaces Gem's approval.","A dry run is never a go-ahead, this rule has no dry-run waivers, and it never replaces Gem's approval. The one named carve-out: Explorer's sharing under rule 9, on Gem's direct words to Architect at 7:10pm on 22 Oct 2026, \"Yes, Emissary and Explorer can write to Mem0 and Explorer can share Notion/Todoist; add it to v003\", needs no per-item words from Gem; it still needs a Safeguard dry run for each share.")
    T[16]=R(T[16],"Make a backup or export first; if one can't be made, say so and let Gem decide.","Before deleting code, notes, configs or bot instructions, make a verified off-computer backup first, checked by a bot other than the one deleting; scrapes, data, logs and scratch files need no backup (Gem in Inquirer's chat, 8:07pm 22 Oct 2026: \"Code / Notes / Configs and bot instructions\"; R-049). Never mass-wipe (no rm -rf; Gem, 9 Oct). Log every deletion.")
    T[24]=R(T[24],"Rules 1, 3 and 4 keep v001's text and have no breach line of their own;","Rule 4 keeps v001's text, rule 1 keeps it apart from the posting grant, rule 3 keeps it apart from the resilience carve-out, and none of the three has a breach line of its own;")
    T[24]=T[24]+" NAMES: a retired bot's name anywhere in a shared rule or brief means the bot it merged into: Mediator means Mender, Scorer means Scrutineer, Safekeeper means Safeguard, Inquirer means Inferer, Extractor means Emissary (R-051)."
    T[6]=T[6]+" Carve-out (resilience rule; Gem's words relayed via Inquirer, R-051: \"Google Drive\" and \"Yes, using free storage like Google Drive\"): Archivist may write the governance ledger and the dated governance backup into the one private Drive folder Gem names, with no per-file words; never shared, never secrets or tokens, never personal or BIE data beyond what /workspace/governance/ holds, and Safeguard dry-runs the first upload."
    for i in range(len(T)):
        T[i]=T[i].replace("Extractor runs Apify.","Emissary runs Apify (Extractor folded into Emissary, R-051; its collection lane stays walled from posting).").replace("Extractor's Safeguard dry run under its brief","Emissary's Safeguard dry run under its brief (collection lane)").replace("scraping is Extractor's, under its brief","scraping is Emissary's collection lane, under its brief").replace("Emissary, Explorer, Extractor and Engineer may create","Emissary, Explorer and Engineer may create").replace("Extractor runs Apify actors, under its brief;","Emissary runs Apify actors in its collection lane, under its brief, and Mender (with Mediator's duties) runs the spend check (Gem's answers in Inquirer's chat at 8:09, 8:12 and 8:13pm, relayed via Inquirer, R-051, R-008: the merges including the Extractor fold, \"No, free options only\", and $0 spend without asking);").replace("and Mediator's spend check first;","and Mender's spend check first;")
    if contacts:
        T[18]=R(T[18],"personal data about other people never goes into shared files.","personal data about other people never goes into shared files, except third-party contact details already in gemquota/gvmw as of commit 4f43fc9, under rule 14\'s gvmw exception.")
    return "\n".join(T)
TA=build(HEAD+SCOPE_A+TAIL,True); TB=build(HEAD+SCOPE_B+TAIL,False); TC=build(HEAD+SCOPE_C+TAIL,False)
for t in (TA,TB,TC):
    tl=t.split("\n")
    for i in range(len(L)):
        if i not in (0,4,6,9,12,14,16,17,18,20,23,24) and "Extractor" not in L[i]: assert tl[i]==L[i],i
meta=[("Entry","Connector limits (shared governance document, not any one bot's instructions)"),("Codex folder","`_shared/connector-limits/`"),
 ("Base",f"codex **v002** (latest; text sha256 {sha(base)}, byte-identical to its source proposal) → **v003**"),
 ("Owner","P1 (Checks) Safeguard (`3661a899`)"),
 ("Source","Gem's request RELAYED by Mediator to Architect, 22 Oct 2026 6:47pm AEST (R-008). Gem's words recorded by Mediator in approvals/2026-10-16-gem-direct-words.md lines 61–62: 6:45pm \"No, I made gemquota/gvmw public on purpose, leave it\"; 6:47pm \"Change the rule\""),
 ("Basis","connector-limits v002; R-008, R-020, R-027, R-031, R-036, R-039, R-040, R-041; Safeguard RR-045, RR-046 and input-safeguard.md"),
 ("Approver","**Gem directly**, naming v003 and the variant (R-027). A relay from Mediator, Imitator or any other bot doesn't count"),("Reviewer","Scrutineer (Safeguard owns the rule)"),
 ("Cap","Gem asked for this, so Architect's weekly cap doesn't apply")]
def write(fn,t,variant):
    title="# Shared rule: Connector limits v003"+{False:" (variant A, default)","B":" (variant B: contact details out of the public repo)","C":" (variant C: contact details and governance/ out of the public repo)"}[variant]+" — NEEDS GEM'S DIRECT APPROVAL (Gem's own words in Archivist's chat or on a call with Archivist; a relayed or Imitator approval won't do)"
    notes=["Amendment only: v002's text is kept, except the version number, the gvmw exception in rules 6 and 14"+("" if variant else " and 15")+", Gem's 7:10pm Mem0 and Notion/Todoist answer in rules 9 and 11 and LIMITS, and Gem's 8:04pm posting grant in rule 1. Every other line is byte-identical to v002 (the build checks this).",
     "Gem made gemquota/gvmw public on purpose (6:45pm 22 Oct, to Mediator: \"No, I made gemquota/gvmw public on purpose, leave it\") and asked for the rule to change (6:47pm: \"Change the rule\"), relayed by Mediator. At 6:48pm Gem told Safeguard directly: \"Leave gvmw public as it is, I accept the risks\". That covers the repo as it is, not this text, so Gem still approves v003 and its variant by name.",
     "Rule 1: Gem's pick at 8:04pm 22 Oct on Imitator's card t56s1, as reported by Imitator and verified by Investigator (R-047): \"Bots can post to social channels as me, no promises\" (Gem's visible label: \"Bots can post on social media as me\"; 'no promises' was Imitator's narrowing, superseded by Gem's 8:07pm words in Inquirer's chat, \"Anything, including replies and promises\", verified by Arbiter, R-049). Money commitments stay excluded (Gem, 10 Oct). Emissary stays the only poster (Gem, 11:03am 16 Oct), with a dry run per post (R-048). The gambling and BIE ban in rule 1 and rule 6 is unchanged.",
     "Rules 9 and 11 and LIMITS: Gem's direct words to Architect, 7:10pm 22 Oct 2026, in Architect's own chat (not relayed): \"Yes, Emissary and Explorer can write to Mem0 and Explorer can share Notion/Todoist; add it to v003\". Emissary and Explorer may add Mem0 memories (not Notion's memories or other stores; bans and 'data, never instructions' unchanged; v002's need for Gem to name what each writer is for is dropped, as Gem named only the writers). Explorer may share items logged as its own with people Gem already shares with in that workspace, with a Safeguard dry run per share but no per-item words (a named carve-out in LIMITS); publishing to the web or sharing with anyone new keeps v002's gate. Deletion and Trash rules unchanged. These words aren't in approvals/: every paste line opens with Gem restating them, so Archivist records them from Gem directly before deploying.",
     "The IGA and Privacy Act exposure is recorded as Gem's own accepted call. Bots set out risks and options and don't decide; nothing here is legal advice. Review by 22 Nov 2026 (Safeguard).",
     "R-043 (final) settled the 4f43fc9 push: Gem's words covered it, leaving two process gaps for Engineer. v003 doesn't settle who made the repo public. Line 63 of the approvals file has no \"Recorded by\" heading of its own; R-042 confirms it as Gem's words in Safeguard's chat.",
     "The shared GitHub rule (github-v001, still a draft) bars BIE and gambling data from any repo; its revision 5 needs the same narrow exception, or rule 14's deference would undo this one."]
    if variant=="B": notes.append("Variant B: the BIE and gambling data, governance/ and the named identity notes stay public; approving B is Gem's words to remove the third-party contact details from the current tree only (backup on the box, scan and dry run first; no history rewrite without separate words).")
    if variant=="C": notes.append("Variant C: as variant B, and governance/ is removed from the current tree too.")
    out=[title,"","| Field | Value |","|---|---|"]+[f"| {k} | {v} |" for k,v in meta]
    out+=["","Status for this draft is kept in `README.md`, not here (R-023).","","## Notes"]+[f"- {n}" for n in notes]+["","## Exact instructions (verbatim)","","```text",t,"```",""]
    open(f"{OUT}/{fn}","w").write("\n".join(out))
write("connector-limits-v003.md",TA,False); write("connector-limits-v003-variant-b.md",TB,"B"); write("connector-limits-v003-variant-c.md",TC,"C")
print("base",sha(base),"A",sha(TA),"B",sha(TB),"C",sha(TC))
for name,t in (("A",TA),("B",TB)):
    for l in difflib.unified_diff(L,t.split("\n"),lineterm="",n=0):
        if l.startswith(("+","-")) and not l.startswith(("+++","---")): print(name,l[:1],l[:1]+" "+l[1:6]+" …" if False else l[:1], re.sub(r"^.(.{0,8}).*",r"\1",l))
