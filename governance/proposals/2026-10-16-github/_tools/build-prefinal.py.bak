for fn,title,folder,ver,agent,label,anchor,appr,note in [
 ("inquirer-v005.md","Inquirer v005 — GitHub read-only pointer","identity-inquirer",4,"0314faa4","P2 (ID) Inquirer (live), `0314faa4`",MVE,"**Gem directly** (whole batch routed to Gem, R-027)","Its brief cites the message verification rule only for checking cut-off messages, so the rule's GitHub item alone doesn't bind it (re-review item 2)."),
 ("inferer-v006.md","Inferer v006 — GitHub read-only pointer","identity-inferer",5,"94516ca6","P2 (ID) Inferer (live), `94516ca6`",MVE,"**Gem directly** (whole batch routed to Gem, R-027)","As Inquirer."),
 ("archivist-v009.md","Archivist v009 — GitHub read-only pointer","codex-keeper",8,"61ef3abd","P1 (Roles) Archivist (live), `61ef3abd`",ENDS,"**Gem directly**: Archivist's own brief is never deployed on an Imitator approval (codex-keeper v008; Scrutineer review-3)","Archivist's own brief: Gem only, whatever the change (Scrutineer review-3 and the redundancy review).")]:
    new = (anchor+" "+RO) if anchor==MVE else (RO+" "+ENDS)
    bot(fn,title,folder,ver,agent,label,[(anchor,new,"GitHub read-only pointer")],GEM if folder=="codex-keeper" else IMI,appr,[note])

