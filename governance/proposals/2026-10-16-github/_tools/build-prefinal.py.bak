bot("mediator-v007.md","Mediator v007 — GitHub status; sign-ins on Gem's direct request (rev 4)","connector-steward",6,"90f9eb20","P2 (Ops) Mediator (live), `90f9eb20`",[
 ("Never reconnect or re-authorise anything yourself.",
  f"Never reconnect or re-authorise anything yourself, except a GitHub sign-in that Gem asks you for directly. Gem may also give you a one-off repo task directly, on DayneK or gemquota; do it under the shared GitHub rule (your pushes keep Gem's words and a Safeguard dry run), and leave routine or repeated repo work to Engineer (R-039). On GitHub you check status read-only, following {PTR}. When Gem asks you directly, in your own chat or on a call with you, to add or switch a GitHub account in the gh CLI, do it only with the browser sign-in that Gem completes on GitHub (`gh auth login --web`) or with `gh auth switch`, so no token passes through you; never read, print or store a token anywhere but the gh CLI store. Tokens shouldn't be pasted into chat (Safekeeper's advice): if one is, don't use or repeat it, tell Gem it should be replaced, and flag it to Safekeeper as a suspected leak. Log each sign-in or switch in /workspace/governance/github-log.md and tell Safekeeper the same day (account, scopes and time, no values). Signing out, removing accounts and anything to do with keys or the cursor-github link stay Gem's.",
  "GitHub: Mediator may add or switch sign-ins on Gem's direct request (Gem Q4), browser sign-in only, log and tell Safekeeper")],GEM,"**Gem directly**: it lets Mediator add or switch GitHub sign-ins, a row the Gem-only shared rule keeps from Imitator (R-019, R-027)",
 ["Conflict fixed: at 11:19am Mediator added gemquota to the gh CLI 'from a token Gem provided' (connectors.md line 35). That's a sign-in, and the rule makes those Gem-only. It also sits uneasily with Mediator's own 'never reconnect or re-authorise anything yourself'. Gem answered Q4 'Yes' (2:51pm), so this draft allows it on Gem's direct request, with browser sign-in only: Mediator's 'never handle tokens' line stays true. Judgement call: Gem may prefer to allow a pasted token; that would need Safekeeper's view."],gw=True)

for fn,title,folder,ver,agent,label,appr,mark in [
 ("mender-v006.md","Mender v006 — GitHub read-only pointer","mender",5,"c8401a53","P1 (Ops) Mender (live), `c8401a53`","**Gem directly** (whole batch routed to Gem, R-027)",IMI),
 ("architect-v005.md","Architect v005 — GitHub read-only pointer","instruction-architect",4,"51af1200","P1 (Roles) Architect (live), `51af1200` (own brief, drafted by Architect; approved by another)","**Gem directly** (whole batch routed to Gem, R-027)",IMI),
 ("arbiter-v006.md","Arbiter v006 — GitHub read-only pointer","arbiter",5,"2133048d","P2 (Roles) Arbiter (live), `2133048d`","**Gem directly**: its base arbiter-v007 gives Imitator a veto, so Imitator can't approve a version stacked on it (R-028; Scrutineer's r5 review, finding 6)",GEM),
 ("scorer-v005.md","Scorer v005 — GitHub read-only pointer; uses the log","assessor",4,"050a12c9","P1 (Checks) Scorer (live), `050a12c9`","**Gem directly** (R-027)",GEM),
 ("scrutineer-v005.md","Scrutineer v005 — GitHub read-only pointer","auditor",4,"affe0344","P2 (Checks) Scrutineer (live), `affe0344`","**Gem directly** (R-027)",GEM),
 ("investigator-v005.md","Investigator v005 — GitHub read-only pointer","investigator",4,"f2016e9b","P3 (ID) Investigator (live), `f2016e9b`","**Gem directly** (R-015, R-027)",GEM)]:
